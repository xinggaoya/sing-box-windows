{
  "name": "sing-box-windows",
  "version": "2.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "lint:oxlint": "oxlint . --fix -D correctness",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "test:kernel-targets": "node --test scripts/kernel-targets.test.mjs",
    "format": "prettier --write src/",
    "kernel:fetch": "node scripts/fetch-kernel.mjs",
    "kernel:fetch:all": "node scripts/fetch-kernel.mjs --all",
    "tauri": "node scripts/tauri-wrapper.mjs",
    "tauri dev": "node scripts/tauri-wrapper.mjs dev",
    "tauri build": "node scripts/tauri-wrapper.mjs build",
    "tauri build:linux:rpm": "node scripts/tauri-wrapper.mjs build:linux:rpm",
    "tauri build:windows:arm64": "node scripts/tauri-wrapper.mjs build:windows:arm64"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tauri-apps/plugin-websocket": "~2.4.2",
    "@tauri-apps/plugin-window-state": "^2.4.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.4.0",
    "flag-icons": "^7.5.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/node20": "^20.1.9",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-oxlint": "^1.76.0",
    "eslint-plugin-vue": "^10.10.0",
    "mitt": "^3.0.1",
    "naive-ui": "^2.44.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.76.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vfonts": "^0.0.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
